          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Contrato: csrfToken é texto\", () => pm.expect(j.csrfToken).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"csrf\", j.csrfToken);"
                ]
              }
            }
          ]
        },
