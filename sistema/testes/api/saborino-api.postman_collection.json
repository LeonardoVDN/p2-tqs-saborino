                  "pm.test(\"Produtos do seed presentes\", () => { pm.expect(bolo).to.be.ok; pm.expect(mousse).to.be.ok; });",
                  "pm.collectionVariables.set(\"bolo_id\", bolo.id); pm.collectionVariables.set(\"mousse_id\", mousse.id);"
