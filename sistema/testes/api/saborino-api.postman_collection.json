                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Contrato: lista com id, nome e preco_venda\", () => { pm.expect(j).to.be.an(\"array\").that.is.not.empty; j.forEach(p => pm.expect(p).to.include.keys(\"id\", \"nome\", \"preco_venda\")); });",
