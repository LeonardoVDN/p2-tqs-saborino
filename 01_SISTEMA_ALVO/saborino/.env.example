# Variáveis lidas pelo docker-compose.yml (interpolação ${...}) no ambiente LOCAL.
# Copie para .env: cp .env.example .env
# As variáveis da aplicação Django ficam em backend/.env.

# Portas expostas no host (troque se houver conflito com outro serviço)
API_PORT=8000
FRONTEND_PORT=5173
FLOWER_PORT=5555

# URL da API usada pelo frontend (deve bater com API_PORT)
VITE_API_URL=http://localhost:8000/api/v1
