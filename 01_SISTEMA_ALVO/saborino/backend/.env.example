# Banco de dados PostgreSQL
POSTGRES_DB=sistema_saborino_db
POSTGRES_USER=sistema_saborino_user
POSTGRES_PASSWORD=mudar_senha_aqui

# Django
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Flower (monitoramento do Celery)
FLOWER_BASIC_AUTH=admin:mudar_senha_aqui

# Email (console por padrão para desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para usar SMTP real, comente a linha acima e configure:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app
