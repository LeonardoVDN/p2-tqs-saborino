/*
!/.gitignore
!/README.md
!/sistema/
/sistema/*
!/sistema/saborino/
!/sistema/ambiente/

__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
.DS_Store
.env
!*.env.example
*.log
.pytest_cache/
